# For scripts/download.sh. Copy to .env (gitignored) and fill in.
#
# Use a read-only R2 API token ("Object Read only", this bucket only), not
# the read & write token the workflow uses.

# Shown on the R2 overview page in the Cloudflare dashboard
R2_ACCOUNT_ID=
R2_BUCKET=clusterflick-data-transformed-backup
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
